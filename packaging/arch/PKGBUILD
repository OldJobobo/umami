# Maintainer: OldJobobo
#
# Built from this checkout by ../build (which makes the source tarball).
pkgname=umami
pkgver=0.1.0
pkgrel=1
pkgdesc="Flavors for Omarchy: a recipe of changes recomposed onto stock Omarchy on every update"
arch=(any)
url="https://github.com/OldJobobo/umami"
license=(MIT)
depends=(omarchy python git)
install=umami.install
source=("$pkgname-$pkgver.tar.gz")
sha256sums=(SKIP)

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 bin/umami "$pkgdir/usr/lib/umami/bin/umami"
  install -Dm644 -t "$pkgdir/usr/lib/umami/umami" umami/*.py
  install -d "$pkgdir/usr/bin"
  ln -s /usr/lib/umami/bin/umami "$pkgdir/usr/bin/umami"
  install -Dm644 system/90-umami.hook "$pkgdir/usr/share/libalpm/hooks/90-umami.hook"
  # At each login: after a flavor is removed, each user's things go back.
  install -Dm644 system/umami-login.desktop "$pkgdir/etc/xdg/autostart/umami.desktop"
  install -Dm644 -t "$pkgdir/usr/lib/systemd/system" system/umami-users.path system/umami-users.service

  # The example flavors.
  local flavor
  for flavor in zen shibumi command-palette mac-switcher company server; do
    install -d "$pkgdir/usr/share/umami/flavors/$flavor"
    cp -r --no-preserve=ownership "examples/$flavor/." "$pkgdir/usr/share/umami/flavors/$flavor/"
  done
  install -Dm644 README.md "$pkgdir/usr/share/doc/umami/README.md"
}
